#!/bin/sh
#
# Workspace launcher
#
# Author: Thomas Frössman  ( thomasf@jossystem.se / http://thomas.jossystem.se )
#

# args: name, cmd [args...]
launchTerminal(){
    name="${1}"
    shift
    if hash "${1}" 2>/dev/null; then
        term-run -n "${name}" -m loop -- "$@" &
    fi
}

case $(wsname -s) in
  io)
    launchTerminal "iotop" sudo iotop
    launchTerminal "dstat" dstat -avf
    exit 0
  ;;
esac

wsname -s && exit 1


# launchTerminal "pamixer" "pamixer" "-a 2"
# pavucontrol &


if hash pipmix 2>/dev/null; then
   launchTerminal "pipmix" "pipmix"
else
  launchTerminal "pipemixer" "pipemixer"
fi

sleep 0.15

if hash sysbars 2>/dev/null; then
   launchTerminal "sysbars" "sysbars"
else
  launchTerminal "pipemixer" "pipemixer"
fi

sleep 0.15

if hash mpdplay 2>/dev/null; then
   launchTerminal "mpdplay" "mpdplay"
else
  launchTerminal "ncmpcpp" "ncmpcpp"
fi
