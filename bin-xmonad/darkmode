#!/bin/sh
#
# Switch between light and dark mode. dotfiles theme switches the theme and
# runs the [[script]] entries with on = "theme", which reload the desktop
# (see xmonad/dotfiles.toml).

case ${1} in
  l|light)
    exec dotfiles theme set light
    ;;
  d|dark)
    exec dotfiles theme set dark
    ;;
  *)
    exec dotfiles theme toggle
    ;;
esac
