#!/bin/bash
#
# dmenu compatibility wrapper delegating to rofi
#

if [ -x "${HOME}/bin/rofi" ]; then
  cmd="${HOME}/bin/rofi"
elif command -v rofi >/dev/null 2>&1; then
  cmd=rofi
else
  echo "rofi not found" >&2
  command -v notify-send >/dev/null 2>&1 && notify-send -u critical "rofi not found"
  exit 1
fi

exec $cmd -dmenu -i "$@"

