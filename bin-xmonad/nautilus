#!/bin/bash
#
# Nautilus wrapper
#

bin=/usr/bin/nautilus
nargs="--new-window"

#bin=/usr/bin/pcmanfm
#nargs="-n"

if [ $# -eq 0 ]; then

    source ~/.config-base/bash/common

    if command -v ws >/dev/null 2>&1; then
        name="$(ws name -p 2>/dev/null)"
        case $name in
            home|temp|chat|nodes|dash|NSP)
                cd ${HOME}
                ;;
            emacs)
                cd ~/.emacs.d
                ;;
            www|share|mail)
                cd ~/Downloads
                ;;
            books)
                cd ~/books
                ;;
            # *)
            # cd $(zzz "${HOME}" "${name/-/ }")
            # ;;
        esac
    fi
    exec $bin $nargs .
else
    exec $bin $nargs "$@"

fi
