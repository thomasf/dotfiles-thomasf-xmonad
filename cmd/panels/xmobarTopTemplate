Config { font = "Pragmata Pro 27px"
       , additionalFonts = ["Pragmata Pro 17px", "Pragmata Pro Bold 16px"]
       , borderColor = "{{ .C "bg_0" }}"
       , bgColor = "{{ .C "bg_0" }}"
       , fgColor = "{{ .C "fg_0" }}"
       , allDesktops = True
       , alpha = 255
       , border = NoBorder
       , hideOnStart = False
       , iconOffset = -1
       , iconRoot = "."
       , lowerOnStart = True
       , overrideRedirect = True
       , persistent = True
       , pickBroadest = False
     {{ if eq .Width 0 }}
       , position = TopSize C 100 {{ .Height }}
     {{ else }}
       , position =  Static { xpos = {{ .Xpos }}, ypos = {{ .Ypos }}, width = {{ .Width }}, height = {{ .Height }}  }
     {{ end }}
       , textOffset = -1
       , commands = [ Run NamedXPropertyLog "_XMONAD_LOG_TOP" "xm"
                    , Run DynNetwork ["-t", "<dev>:t<tx>:r<rx>k", "-L","0","-H","1000","--normal","{{ .C "fg_0" }}","--high","{{ .C "fg_1" }}"] 30
                    , Run MultiCpu ["-t", "<total>%", "-L","3","-H","80","--normal","{{ .C "fg_1" }}","--high","{{ .C "red" }}", "-c", "0", "-p", "2"] 10
                    , Run Memory ["-t","<fc={{ .C "fg_1" }}><available></fc>M"] 30
                    , Run DateZone "%a %b %-d %H:%M" "en_US.utf8" "Europe/Stockholm" "sthmlDate" 10
                    , Run DateZone "%H:%M" "en_US.utf8" "UTC" "time2" 10
                    -- , Run DateZone "%H:%M" "en_US.utf8" "America/Montreal" "time3" 10
                    , Run Battery ["-t", "<left>%", "-L", "10", "-H", "80"
                                  , "--"
                                  , "-L", "-15", "-H", "-5", "-l", "{{ .C "fg_1" }}", "-m", "{{ .C "fg_1" }}", "-h", "{{ .C "fg_1" }}"] 600
                     -- , Run DiskIO [("/", "/ w<fc={{ .C "fg_1" }}><write></fc> r<fc={{ .C "fg_1" }}><read></fc>")] [] 20
       ]
       , sepChar = "%"
       , alignSep = "}{",
       , template = "%xm% }{ <fn=1>%dynnetwork%  <action=`x.info` button=1>ma%memory%  cu%multicpu%  b%battery%</action></fn>  <fn=1><fc={{ .C "green" }}><action=`x.todo` button=1>%sthmlDate%</action></fc> <fc={{ .C "fg_0" }}>UTC:%time2% </fc>  </fn>"
}