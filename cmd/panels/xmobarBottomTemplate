Config { font = "Roboto Condensed 26px"
       , additionalFonts = ["Roboto Condensed 26px", "Pragmata Pro Bold 18px"]
       , borderColor = "{{ .C "bg_1" }}"
       , bgColor = "{{ .C "bg_0" }}"
       , fgColor = "{{ .C "fg_1" }}"
       , allDesktops = True
       , alpha = 255
       , border = TopB
       , hideOnStart = False
       , iconOffset = -1
       , iconRoot = "."
       , lowerOnStart = True
       , overrideRedirect = True
       , persistent = True
       , pickBroadest = False
       , position = BottomSize C 100 32
       , textOffset = -1
       , commands = [ Run NamedXPropertyLog "_XMONAD_LOG_BOTTOM" "xm"
                    , Run Kbd [("us(intl-unicode)", "US"), ("us", "US"), ("se(nodeadkeys)", "SE"), ("se", "SE"), ("se(mac)", "SE mac")]
                    ]

       , sepChar = "%"
       , alignSep = "}{"
       , template = "  <fn=1><fc={{ .C "fg_1" }}>%kbd%</fc></fn>   <fc={{ .C "yellow" }}>%xm%</fc>"
