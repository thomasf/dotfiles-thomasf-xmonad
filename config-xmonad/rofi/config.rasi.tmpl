// Generated from dotfiles/xmonad/config-xmonad/rofi/config.rasi.tmpl.
@import "colors.rasi"

configuration {
  font: "PragmataPro 11";
  dpi: {{.vars.dpi}};
  kb-primary-paste: "Alt+y,Shift+Insert";
  kb-secondary-paste: "Control+y,Insert";
  kb-page-prev: "Alt+v,Page_Up";
  kb-page-next: "Control+v,Page_Down";
}

window {
  width: 75%;
  border: {{expr "int(round(2.0 * float(vars.dpi_scale_int)))"}}px;
  padding: {{expr "int(round(4.0 * float(vars.dpi_scale_int)))"}}px;
}

listview {
  lines: 30;
  scrollbar: false;
}
