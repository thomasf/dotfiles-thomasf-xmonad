// rofi colours for light mode, the Selenized colours of the XMonad prompts.
// darkmode links ~/.config/rofi/colors.rasi to this file or its pair.
* {
  bg:               #ece3cc;
  bg-alt:           #d5cdb6;
  fg:               #3a4d53;
  fg-dim:           #909995;
  accent:           #ca4898;

  background-color: transparent;
  text-color:       @fg;
}

window {
  background-color: @bg;
  border-color:     @bg-alt;
}

prompt {
  text-color:       @accent;
}

textbox {
  text-color:       @fg-dim;
}

element {
  padding:          2px 6px;
}

element normal.normal, element alternate.normal {
  background-color: transparent;
  text-color:       @fg;
}

element selected.normal {
  background-color: @bg-alt;
  text-color:       @accent;
}

element-text {
  background-color: inherit;
  text-color:       inherit;
}
