// rofi colours, from the theme in use ({{.theme.name}}:{{.theme.variant}}).
// The window is a raised surface: bg_1 with fg_1 text, and bg_2 for the
// selected row.
* {
  bg:               {{.theme.colors.bg_1}};
  bg-alt:           {{.theme.colors.bg_2}};
  fg:               {{.theme.colors.fg_1}};
  fg-dim:           {{.theme.colors.dim_0}};
  accent:           {{.theme.colors.magenta}};

  // The default theme's colours, used by the entry and other widgets this
  // file does not style.
  foreground:       @fg;
  background:       @bg;
  lightfg:          @fg-dim;
  lightbg:          @bg-alt;

  background-color: transparent;
  text-color:       @fg;
}

window {
  background-color: @bg;
  border-color:     @bg-alt;
}

prompt {
  text-color:       @accent;
}

textbox {
  text-color:       @fg-dim;
}

element {
  padding:          2px 6px;
}

element normal.normal, element alternate.normal {
  background-color: transparent;
  text-color:       @fg;
}

element selected.normal {
  background-color: @bg-alt;
  text-color:       @accent;
}

element-text {
  background-color: inherit;
  text-color:       inherit;
}
