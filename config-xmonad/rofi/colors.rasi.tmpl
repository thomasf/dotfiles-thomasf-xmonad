// rofi colours, from the theme in use ({{.theme.name}}:{{.theme.variant}}).
// The window is a raised surface: bg_1 with fg_1 text, and bg_2 for the
// selected row. Hints are dim_1, a stronger dim than dim_0, which is hard
// to read on bg_1.
* {
  bg:               {{.theme.colors.bg_1}};
  bg-alt:           {{.theme.colors.bg_2}};
  fg:               {{.theme.colors.fg_1}};
  fg-dim:           {{or (index .theme.colors "dim_1") .theme.colors.dim_0}};
  accent:           {{.theme.colors.magenta}};

  // The default theme's colours, used by the entry and other widgets this
  // file does not style.
  foreground:       @fg;
  background:       @bg;
  lightfg:          @fg-dim;
  lightbg:          @bg-alt;
  blue:             {{.theme.colors.blue}};
  red:              {{.theme.colors.red}};
  separatorcolor:   @bg-alt;

  background-color: transparent;
  text-color:       @fg;
}

window {
  background-color: @bg;
  border-color:     @bg-alt;
}

prompt {
  text-color:       @accent;
}

entry {
  placeholder-color: @fg-dim;
}

num-filtered-rows, num-rows, textbox-num-sep {
  text-color:       @fg-dim;
}

scrollbar {
  handle-color:     @bg-alt;
}

textbox {
  text-color:       @fg-dim;
}

element {
  padding:          2px 6px;
}

element normal.normal, element alternate.normal {
  background-color: transparent;
  text-color:       @fg;
}

element selected.normal {
  background-color: @bg-alt;
  text-color:       @accent;
}

element normal.active, element alternate.active {
  background-color: transparent;
  text-color:       @blue;
}

element selected.active {
  background-color: @bg-alt;
  text-color:       @blue;
}

element normal.urgent, element alternate.urgent {
  background-color: transparent;
  text-color:       @red;
}

element selected.urgent {
  background-color: @bg-alt;
  text-color:       @red;
}

element-text {
  background-color: inherit;
  text-color:       inherit;
}
