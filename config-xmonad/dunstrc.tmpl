# -*- mode: conf -*-
{{- $c := .theme.colors}}
# Colors of the theme in use, {{.theme.name}}:{{.theme.variant}}: each kind of
# notification has its accent, as a tint of bg_0 behind text that is the
# accent mixed toward fg_1 (see dotfiles doc mix).

[global]
# font = Monospace 8
# font =  -*-terminus-bold-r-normal--18-*-*-*-*-*-*-*
font =  PragmataPro 10
markup = full
plain_text = no
format = "[%a] %s %b"
sort = yes
indicate_hidden = yes
alignment = left
bounce_freq = 0
show_age_threshold = 120
word_wrap = yes
geometry = "1000x10-0+32"
{{- if eq .hostname "flam"}}
# wider than the default 300 on the 4K screens of flam
width = 500
{{- end}}
shrink = no
transparency = 0
idle_threshold = 120
monitor = 0
{{- if eq .hostname "flam"}}
# pinned to monitor 0, the primary screen of flam
follow = none
{{- else}}
follow = keyboard
{{- end}}
sticky_history = yes
line_height = 4
separator_height = 0
padding = 18
horizontal_padding = 20
separator_color = auto
dmenu = dmenu -p dunst:
browser = www
ignore_newline = no
frame_width = 0
ellipsize = middle
stack_duplicates = true
show_indicators = yes
history_length = 100
corner_radius = 8
mouse_left_click = do_action, close_current
mouse_middle_click = close_all
mouse_right_click = close_current

# urgency based templates

[urgency_low]
background = "{{mix $c.bg_0 $c.cyan 0.1}}"
foreground = "{{mix $c.cyan $c.fg_1 0.4}}"
timeout = 7

[urgency_normal]
background = "{{mix $c.bg_0 $c.green 0.1}}"
foreground = "{{mix $c.green $c.fg_1 0.4}}"
timeout = 30

[urgency_critical]
background = "{{mix $c.bg_0 $c.red 0.1}}"
foreground = "{{mix $c.red $c.fg_1 0.4}}"
timeout = 0

[orgmode]
appname = "orgmode"
format = "%s %b"
background = "{{mix $c.bg_0 $c.yellow 0.1}}"
foreground = "{{mix $c.yellow $c.fg_1 0.4}}"
timeout = 0

[todo]
appname = "todo"
format = "TODO %b"
background = "{{mix $c.bg_0 $c.green 0.1}}"
foreground = "{{mix $c.green $c.fg_1 0.4}}"
timeout = 0

# other templates

[network-manager]
appname = "NetworkManager"
format = "%s %b"
urgency = low
background = "{{mix $c.bg_0 $c.blue 0.1}}"
foreground = "{{mix $c.blue $c.fg_1 0.4}}"

[short]
appname = "short"
format = "%s %b"
background = "{{mix $c.bg_0 $c.magenta 0.1}}"
foreground = "{{mix $c.magenta $c.fg_1 0.4}}"
timeout = 5

[signal]
appname = "Signal"
format = "%s %b"
background = "{{mix $c.bg_0 $c.blue 0.1}}"
foreground = "{{mix $c.blue $c.fg_1 0.4}}"
timeout = 20

[Chrome]
appname = "Google Chrome"
format = "%s %b"
background = "{{mix $c.bg_0 $c.blue 0.1}}"
foreground = "{{mix $c.blue $c.fg_1 0.4}}"
timeout = 20


[shorter]
appname = "shorter"
format = "%s %b"
background = "{{mix $c.bg_0 $c.cyan 0.1}}"
foreground = "{{mix $c.cyan $c.fg_1 0.4}}"
timeout = 2

[clock]
appname = "clock"
format = "%s %b"
background = "{{mix $c.bg_0 $c.green 0.1}}"
foreground = "{{mix $c.green $c.fg_1 0.4}}"
timeout = 30

[sticky]
appname = "sticky"
format = "%s %b"
background = "{{mix $c.bg_0 $c.yellow 0.1}}"
foreground = "{{mix $c.yellow $c.fg_1 0.4}}"
timeout = 0

[ignore-dropbox]
appname = Dropbox
summary = "*"
format = ""

[8bitdo-numpad]
appname = blueman
summary = "8BitDo Retro 18 Numpad*"
background = "{{mix $c.bg_0 $c.cyan 0.1}}"
foreground = "{{mix $c.cyan $c.fg_1 0.4}}"
urgency = low
format = "%s %b"
timeout = 2


